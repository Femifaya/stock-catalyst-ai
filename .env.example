# ---------------------------------------------------------------------------
# Stock Catalyst AI - environment template
# ---------------------------------------------------------------------------
# Copy to `.env.local` and fill in. NEVER commit `.env.local`.
# Every variable below is optional unless marked REQUIRED. With no keys set the
# app boots in DEMONSTRATION mode: clearly-labelled synthetic data, no network.
# Credentials are read on the server only. Nothing prefixed with NEXT_PUBLIC_
# exists in this project by design.

# --- Runtime ---------------------------------------------------------------
# NODE_ENV is set by Next.js. APP_ENV tunes logging/telemetry.
APP_ENV=development
# Port for `next dev` / `next start`.
PORT=3000
# Minimum: 0.25 = quiet, 1 = verbose.
LOG_LEVEL=0.5

# --- Database (SQLite via better-sqlite3) ----------------------------------
# Relative paths resolve from the project root.
DATABASE_PATH=./data/stock-catalyst.sqlite
# Run migrations automatically on first request (dev convenience).
DATABASE_AUTO_MIGRATE=true

# --- AI: Qwen (Alibaba Cloud Model Studio, OpenAI-compatible) --------------
# REQUIRED for live AI research. Without it the pipeline returns an explicit
# "AI unavailable" state and the workbench still shows data + indicators.
QWEN_API_KEY=
# OpenAI-compatible base URL. No trailing slash.
QWEN_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
# Any Qwen chat model your account can call, e.g. qwen-plus, qwen-max, qwen3-235b-a22b.
QWEN_MODEL=qwen-plus
QWEN_TIMEOUT_MS=45000
QWEN_MAX_RETRIES=2
QWEN_MAX_TOKENS=3000
# Keep low: this is analysis, not creative writing.
QWEN_TEMPERATURE=0.2
# Reject any model output that fails strict schema/citation validation.
QWEN_STRICT_VALIDATION=true

# --- Market data providers -------------------------------------------------
# Comma-separated preference order. `auto` uses every configured provider and
# falls back in order. `demo` forces offline demonstration data.
MARKET_DATA_PROVIDER=auto
# Optional free-tier keys. Each adapter degrades gracefully when absent.
FINNHUB_API_KEY=
ALPHAVANTAGE_API_KEY=
TWELVEDATA_API_KEY=
# Stooq needs no key and is used for daily OHLCV when available.
STOOQ_ENABLED=true
# Per-provider request ceiling (free tiers are typically 5-60 req/min).
PROVIDER_REQUESTS_PER_MINUTE=20
PROVIDER_HTTP_TIMEOUT_MS=10000
# Cached quote freshness before it is labelled "stale".
CACHE_TTL_QUOTE_SECONDS=60
CACHE_TTL_CANDLES_SECONDS=3600
CACHE_TTL_FUNDAMENTALS_SECONDS=21600
CACHE_TTL_NEWS_SECONDS=900
# Data older than this is rendered with a STALE badge (seconds).
STALE_AFTER_SECONDS=900

# --- CSV upload fallback ---------------------------------------------------
MAX_UPLOAD_BYTES=2097152
MAX_UPLOAD_ROWS=20000

# --- HTTP hardening --------------------------------------------------------
MAX_BODY_BYTES=262144
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=60
# Stricter bucket for the expensive AI pipeline.
RATE_LIMIT_AI_MAX_REQUESTS=6
RATE_LIMIT_AI_WINDOW_SECONDS=60

# --- UI --------------------------------------------------------------------
DEFAULT_HORIZON=3-12_weeks
DEFAULT_RISK_TOLERANCE=medium
# Force demonstration data even when provider keys exist (demos, CI, offline).
DEMO_MODE=false